{
  "hosting": {
    "site": "auto-clicker-auto-fill-static",
    "public": "src",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "src/*.[mjs|ts]"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/"
      }
    ],
    "headers": [
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Content-Type"
          }
        ]
      }
    ]
  }
}
